# Initial cache for an explicitly selected Ara target, not generic RVV hosts.
if (NOT DEFINED ENV{ARA_SDK_ROOT} OR "$ENV{ARA_SDK_ROOT}" STREQUAL "")
    message(FATAL_ERROR "Set ARA_SDK_ROOT to a reviewed SDK archive containing software/qbs and software/akv")
endif()
set(GGML_RISCV_QBS_RUNTIME_DIR "$ENV{ARA_SDK_ROOT}/software/qbs" CACHE PATH "")
set(GGML_RISCV_AKV_RUNTIME_DIR "$ENV{ARA_SDK_ROOT}/software/akv" CACHE PATH "")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_EXE_LINKER_FLAGS "-static" CACHE STRING "")
set(BUILD_SHARED_LIBS OFF CACHE BOOL "")
set(GGML_NATIVE OFF CACHE BOOL "")
set(GGML_RVV ON CACHE BOOL "")
set(GGML_RV_ZFH ON CACHE BOOL "")
set(GGML_RV_ZVFH ON CACHE BOOL "")
set(GGML_RV_ZICBOP OFF CACHE BOOL "")
set(GGML_RV_ZIHINTPAUSE OFF CACHE BOOL "")
set(GGML_OPENMP OFF CACHE BOOL "")
set(GGML_BACKEND_DL OFF CACHE BOOL "")
set(GGML_LLAMAFILE OFF CACHE BOOL "")
set(GGML_CPU_REPACK ON CACHE BOOL "")
set(GGML_RISCV_QBS ON CACHE BOOL "")
set(GGML_RISCV_QBS_M4_PREFLIGHT ON CACHE BOOL "")
set(GGML_RISCV_AKV ON CACHE BOOL "")
set(GGML_RISCV_ACCEL_AUTO ON CACHE BOOL "")
set(GGML_RISCV_AKV_QUANT_KV ON CACHE BOOL "")
set(GGML_RISCV_AKV_QUANT_PREFILL ON CACHE BOOL "")
set(GGML_RISCV_AKV_REGISTER_PV ON CACHE BOOL "")
set(LLAMA_BUILD_TESTS OFF CACHE BOOL "")
set(LLAMA_BUILD_COMMON ON CACHE BOOL "")
set(LLAMA_BUILD_EXAMPLES ON CACHE BOOL "")
set(LLAMA_BUILD_APP OFF CACHE BOOL "")
set(LLAMA_BUILD_TOOLS ON CACHE BOOL "")
set(LLAMA_BUILD_SERVER OFF CACHE BOOL "")
set(LLAMA_OPENSSL OFF CACHE BOOL "")
